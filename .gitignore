# dependencies
/node_modules
/src/node_modules

# podman binaries (downloaded via npm run download-podman)
/podman-bin

# browser extension (downloaded via npm run download-browser-extension)
/browser-extension

# testing
/coverage

# production
/build
/dist

# webpack
/.webpack
/out

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea

eng.traineddata

tmp/*

# Native addon build artifacts (node-gyp)
src/native/build/
*.o
*.a
*.obj
*.so
*.dylib
*.dll
*.node
*.d
*.mk
*.target.mk
.deps/

src/native/build/SimpleTests

.claude
.windsurf

# Rust build artifacts
window-monitor/rust/target/
webview-manager/rust/target/

.vscode/settings.json

# Symlink to local mini-apps directory
src/cobuilding/mini-apps

# Swift dictation helper build output
src/cobuilding/swift/dictation-mac/build/

# Stray webpack main-bundle output that lands at the repo root on some build
# paths. 4 MB of build artifact; never source.
/index.js
/index.js.LICENSE.txt

# share-workers: its own npm install (wrangler is pinned only there, never at
# the repo root) and the viewer bundle esbuild produces from web/viewer/*.ts —
# a build artifact of that source, not source itself.
src/share-workers/node_modules/
src/share-workers/web/public/viewer.js
src/share-workers/web/public/viewer.css

# wrangler's local scratch: `wrangler dev` writes a simulated R2 here, and
# `.dev.vars` is the local-only ACCESS_DISABLED override the README describes.
# Committing either would be a mistake — the second one especially, since it
# turns the sign-in gate off wherever it is read.
src/share-workers/**/.wrangler/
src/share-workers/**/.dev.vars

# Research reports about the private co-scientist repo stay local (plan, question 1)
docs/design/pi-port-research-2026-10-15/co-scientist/
